{
	"name": "@stogas/catalog",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"exports": {
		"./viewer": "./editor/src/catalog.ts",
		"./viewer/types": "./editor/src/types.ts",
		"./public": "./generated/catalog.public.json"
	},
	"packageManager": "bun@1.3.14",
	"overrides": {
		"typescript": "6.0.3"
	},
	"engines": {
		"bun": ">=1.3.14",
		"node": ">=24.6.0"
	},
	"workspaces": [
		"editor"
	],
	"scripts": {
		"build": "node source/scripts/build.mjs",
		"build:editor": "bun run --cwd editor build",
		"check": "bun run format:check && bun run typecheck && bun run build --check && bun test",
		"clean": "node source/scripts/build.mjs --clean",
		"create-release": "node source/scripts/create-release.mjs",
		"editor": "bun run --cwd editor dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"publish-release": "node source/scripts/publish-release.mjs",
		"test": "bun test",
		"typecheck": "bun run --cwd editor typecheck"
	},
	"devDependencies": {
		"prettier": "3.9.6",
		"prettier-plugin-svelte": "4.1.1",
		"typescript": "6.0.3"
	}
}
